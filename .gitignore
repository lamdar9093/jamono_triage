# Données réelles — ne quittent jamais la machine
/data/
/rapports/*.md
!/rapports/README.md
# Tout /lots/ (pas seulement la racine) : un --sortie de lots.py pointant
# vers un sous-dossier (ex. lots/taxonomie/) doit rester couvert lui aussi.
/lots/
/evals/cas/*.md
!/evals/cas/_gabarit.md
/evals/resultats.md

# Secrets
.env

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# OS
.DS_Store
