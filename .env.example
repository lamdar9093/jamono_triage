# Copier ce fichier vers .env et remplir avant de lancer scripts/extraire.py
# .env est ignoré par git — ne jamais le committer.

# URL de base de l'instance Jira, sans slash final
JIRA_BASE_URL=https://jira.exemple-interne.ca

# Authentification — deux modes possibles, un seul jeu de variables à remplir :
#
#   Jira Server / Data Center (le cas le plus probable en environnement
#   bancaire on-prem) : laisser JIRA_EMAIL vide, remplir JIRA_API_TOKEN
#   avec un Personal Access Token (PAT), envoyé en Bearer.
#
#   Jira Cloud : remplir JIRA_EMAIL et JIRA_API_TOKEN (jeton API classique),
#   envoyés en Basic Auth.
JIRA_EMAIL=
JIRA_API_TOKEN=

JIRA_PROJECT_KEY=PECARTES
